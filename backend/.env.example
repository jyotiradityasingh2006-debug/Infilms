# ----- Cloudinary (media uploads) -----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Admin & auth -----
ADMIN_PASSWORD=
JWT_SECRET=

# ----- Server -----
PORT=5000
CORS_ORIGIN=http://localhost:5000

# ----- MongoDB -----
# Leave MONGODB_URI blank to auto-start an in-memory MongoDB for development,
# or set a real connection string (e.g. a MongoDB Atlas cluster) in production.
MONGODB_URI=
MONGODB_DB=infilms